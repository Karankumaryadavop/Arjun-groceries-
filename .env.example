# ==========================================
# Server Network & Security Configuration
# ==========================================
# HOST: Defaults to 127.0.0.1 (loopback-only) for local single-phone / desktop operation.
# Only set HOST=0.0.0.0 behind a managed reverse proxy or container platform with API_AUTH_TOKEN set.
HOST="127.0.0.1"
PORT="3000"

# API_AUTH_TOKEN: Master server authentication token for protected /api/* routes.
# Generate a strong random secret (e.g. `openssl rand -hex 32`) before public or LAN exposure.
# Required in production (NODE_ENV=production). Never put this value in VITE_* frontend env vars.
API_AUTH_TOKEN=""

# SESSION_SIGNING_SECRET: Optional dedicated HMAC key for signing short-lived session tokens.
# Defaults to deriving from API_AUTH_TOKEN or an ephemeral per-boot random secret in local dev.
SESSION_SIGNING_SECRET=""

# ALLOWED_ORIGINS: Comma-separated explicit origin allowlist for browser CORS requests.
# Example: "https://shop.example.com,http://localhost:3000"
ALLOWED_ORIGINS=""

# ==========================================
# Gemini AI API (Server-Side Only)
# ==========================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==========================================
# Meta WhatsApp Business Cloud API Settings
# Keep tokens and credentials server-side ONLY.
# Never expose these values in frontend code or client storage.
# ==========================================
WHATSAPP_WABA_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_TEMPLATE_NAME="payment_reminder_weekly"
WHATSAPP_TEMPLATE_LANGUAGE="hi"
# Generate a random secret token for Meta Webhook GET verification (never use a default placeholder)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Optional dedicated encryption key for runtime-updated WhatsApp tokens (never stored plaintext on disk)
WHATSAPP_SECRET_ENCRYPTION_KEY=""
WHATSAPP_TEST_NUMBER=""
WHATSAPP_SANDBOX_MODE="true"
